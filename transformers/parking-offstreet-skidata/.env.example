LOG_LEVEL="DEBUG"
MQ_QUEUE=s3-poller.meteorology-bz-forecast  
MQ_EXCHANGE=routed  
MQ_KEY=s3-poller.meteorology-bz-forecast 
MQ_CLIENT=tr-meteorology-bz-forecast
MQ_URI=amqp://username:password@localhost:5672

RAW_DATA_BRIDGE_ENDPOINT="http://localhost:2000/"

BDP_BASE_URL=https://share.opendatahub.testingmachine.eu
BDP_PROVENANCE_VERSION=0.1.0
BDP_PROVENANCE_NAME=tr-meteorology-bz-forecast
BDP_ORIGIN=province-bolzano

ODH_TOKEN_URL=https://auth.opendatahub.testingmachine.eu/auth/realms/noi/protocol/openid-connect/token
ODH_CLIENT_ID=
ODH_CLIENT_SECRET=

# Station descriptions from the parking control tower (required).
REFTABLE_DB=skidata
REFTABLE_COLLECTION=parking-offstreet-enrichment
REFTABLE_KEY=key
REFTABLE_MQ_QUEUE=tr-parking-offstreet-skidata-enrichment-local
REFTABLE_MQ_KEY=skidata.parking-offstreet-enrichment
