LOG_LEVEL="DEBUG"
MQ_QUEUE=municipality-bolzano.parking-macello
MQ_EXCHANGE=routed
MQ_KEY=municipality-bolzano.parking-macello
MQ_CLIENT=tr-parking-offstreet-sfhera-dev
MQ_URI=amqp://guest:guest@localhost:5672

BDP_BASE_URL=http://localhost:8081
BDP_PROVENANCE_VERSION=0.1.0
BDP_PROVENANCE_NAME=tr-parking-offstreet-sfhera-dev
BDP_ORIGIN="Municipality Bolzano"

BDP_TOKEN_URL=https://auth.opendatahub.testingmachine.eu/auth/realms/noi/protocol/openid-connect/token
BDP_CLIENT_ID=odh-mobility-datacollector-dev
BDP_CLIENT_SECRET=

RAW_DATA_BRIDGE_ENDPOINT="http://localhost:2000/"
RAW_WRITER_URL=http://localhost:8080

# Station descriptions from the parking control tower (required).
REFTABLE_DB=municipality-bolzano
REFTABLE_COLLECTION=parking-enrichment
REFTABLE_KEY=key
REFTABLE_MQ_QUEUE=tr-parking-offstreet-sfhera-enrichment-local
REFTABLE_MQ_KEY=municipality-bolzano.parking-enrichment
REFTABLE_GATE=false

# Every station seen and what was done with it (required).
DISCOVERY_PROVIDER=municipality-bolzano/parking-discovery
DISCOVERY_GONE_AFTER=0
