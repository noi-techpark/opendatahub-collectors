# Loewenbytes test-environment OAuth2 client credentials (client_credentials
# grant). Reach out to info@loewenbytes.com to obtain these, per the API's
# OpenAPI spec (documentation/260430_openapi-suedtirolmobile-bikebox-api-loewenbytes-v1.0.1.yaml).
#
# Copy this file to ".env" in this same directory (already gitignored) and
# fill in the real values, then run ./validate.sh.

LOEWENBYTES_CLIENT_ID=
LOEWENBYTES_CLIENT_SECRET=
