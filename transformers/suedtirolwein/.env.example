# MQ
MQ_URI=amqp://guest:guest@localhost:5672/
MQ_QUEUE=suedtirolwein.transformer
MQ_EXCHANGE=transformed
MQ_KEY=suedtirolwein.put
MQ_CLIENT=suedtirolwein.transformer

# ODH Content API
ODH_CORE_URL=https://tourism.api.opendatahub.testingmachine.eu/v1
ODH_CORE_TOKEN_URL=https://auth.opendatahub.testingmachine.eu/auth/realms/noi/protocol/openid-connect/token
ODH_CORE_TOKEN_CLIENT_ID=
ODH_CORE_TOKEN_CLIENT_SECRET=
ODH_CORE_REFERER=https://importer.v2.opendatahub.testingmachine.eu/suedtirolwein.companies

PUBLISHED_ON_CHANNELS=suedtirolwein.com

# windows variables
INSECURE_SKIP_VERIFY=
SKIP_SSL_VERIFY=

# Telemetry
SERVICE_NAME=suedtirolwein.transformer
TELEMETRY_TRACE_GRPC_ENDPOINT=

# Logging
LOG_LEVEL=DEBUG
