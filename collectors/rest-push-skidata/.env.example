SERVER_PORT=8080
LOGLEVEL=INFO
MQ_URI=amqp://guest:guest@rabbitmq
MQ_CLIENT=dc-rest-push-skidata
MQ_EXCHANGE=ingress
PROVIDER=skidata/parking-stations

INBOUND_AUTH_USER=testuser
INBOUND_AUTH_PASS=testpass

# Credentials come from the parking control tower now, not from here. The URL
# defaults to its cluster address; these two are read from a mirrored Secret in
# the cluster and have no default, so a local run must supply them.
BACKOFFICE_URL=http://localhost:8090
BACKOFFICE_AUTH_USER=collector
BACKOFFICE_AUTH_PASS=change-me

SERVICE_NAME=dc-rest-push-skidata
TELEMETRY_TRACE_GRPC_ENDPOINT=localhost:4317
